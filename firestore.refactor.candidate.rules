// =============================================================================
// LOCALIZA+ — Firestore Security Rules (Versão Candidata Reestruturada)
// =============================================================================
// Arquivo candidato : firestore.refactor.candidate.rules
// Baseline técnica  : firestore.rules (branch main, commit ad2c6ed114a6a613c76fd842a668f945b0018c46)
// Referência comparada: PDF LOCALIZA+ v1.10.11 (divergências documentadas no relatório)
//
// Princípios de Segurança Preservados:
//   1. Negação padrão (Default Deny) para qualquer caminho não declarado.
//   2. Identidade efetiva baseada no documento /users/{uid} para cargos atribuídos;
//      claims antigas de role=INTRUSO não anulam atribuições administrativas válidas.
//   3. Contas externas (ex.: Gmail) atribuídas administrativamente como SERVIDOR ou
//      ALUNO mantêm seu papel sem rebaixamento automático por domínio de e-mail.
//   4. Blindagem estrita do Root Admin (UID Pinning + e-mail + e-mail verificado).
//   5. Proteção de /role_assignments, /system_config, /signature_requests,
//      /item_return_records e /email_notifications (escrita exclusiva Firebase Admin SDK).
//   6. Política estrita de bloqueios temporários via Timestamp nativo (sem números).
//   7. Otimização de expressões CEL (leitura única parametrizada de users/{uid}).
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SEÇÃO 1 — POLÍTICA PADRÃO DE NEGAÇÃO DE ACESSO (DEFAULT DENY)
    // =========================================================================
    // Qualquer coleção ou subcoleção que não possua regra explícita abaixo é
    // automaticamente bloqueada para leitura e escrita.
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // SEÇÃO 2 — FUNÇÕES FUNDAMENTAIS DE AUTENTICAÇÃO E ACESSO A DOCUMENTOS
    // =========================================================================

    // Verifica se a requisição possui um usuário autenticado no Firebase Auth.
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado corresponde exatamente ao userId do caminho.
    function isAuthUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verifica se o token JWT possui email_verified == true (assume request.auth presente).
    function hasVerifiedEmailToken() {
      let tok = request.auth.token;
      return ('email_verified' in tok) && tok.email_verified == true;
    }

    // Verifica se o usuário está autenticado e com e-mail verificado.
    function isEmailVerified() {
      return isSignedIn() &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }

    // Verifica se existe o documento de perfil /users/{request.auth.uid}.
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Lê os dados do documento de perfil /users/{request.auth.uid}.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Atalho semântico para os dados enviados na escrita atual.
    function incoming() {
      return request.resource.data;
    }

    // Atalho semântico para os dados persistidos antes da operação.
    function existing() {
      return resource.data;
    }

    // =========================================================================
    // SEÇÃO 3 — VERIFICAÇÃO DE E-MAIL E DOMÍNIOS INSTITUCIONAIS (IFPR)
    // =========================================================================
    // Utilizada na classificação automática de contas institucionais (criação e
    // promoção legítima de INTRUSO -> ALUNO/SERVIDOR). Não sobrepõe atribuições
    // administrativas explícitas gravadas em /users/{uid}.

    // Valida padrão de e-mail de estudante IFPR já normalizado em minúsculas.
    function isLowerInstStudentEmail(lowerEmail) {
      return lowerEmail.matches('.*@([a-zA-Z0-9-]+\\.)*(estudantes|estudante|aluno|alunos)[.]ifpr[.]edu[.]br');
    }

    // Valida padrão de e-mail de servidor IFPR já normalizado em minúsculas,
    // excluindo explicitamente subdomínios de estudantes/alunos/escola.
    function isLowerInstStaffEmail(lowerEmail) {
      return lowerEmail.matches('.*@([a-zA-Z0-9-]+\\.)*ifpr[.]edu[.]br') &&
             !lowerEmail.matches('.*@([a-zA-Z0-9-]+\\.)*(aluno|alunos|estudante|estudantes|escola)[.]ifpr[.]edu[.]br');
    }

    // Verifica se o usuário autenticado possui e-mail institucional verificado de estudante.
    function isInstitutionalStudentEmail() {
      let tok = request.auth.token;
      return isSignedIn() && hasVerifiedEmailToken() && ('email' in tok) && tok.email != null && (
        request.auth.token.email.matches('.*@([a-zA-Z0-9-]+\\.)*(estudantes|estudante|aluno)[.]ifpr[.]edu[.]br') ||
        isLowerInstStudentEmail(tok.email.lower())
      );
    }

    // Verifica se o usuário autenticado possui e-mail institucional verificado de servidor.
    function isInstitutionalStaffEmail() {
      let tok = request.auth.token;
      return isSignedIn() && hasVerifiedEmailToken() && ('email' in tok) && tok.email != null && (
        (
          request.auth.token.email.matches('.*@([a-zA-Z0-9-]+\\.)*ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@([a-zA-Z0-9-]+\\.)*(aluno|alunos|estudante|estudantes|escola)[.]ifpr[.]edu[.]br')
        ) ||
        isLowerInstStaffEmail(tok.email.lower())
      );
    }

    // =========================================================================
    // SEÇÃO 4 — ROOT ADMIN E PROTEÇÃO ADMINISTRATIVA (UID PINNING)
    // =========================================================================
    // Blindagem exclusiva do Root Admin por combinação fixa de UID + e-mail +
    // verificação de e-mail. Nunca generalizar para outros usuários.

    // Verifica correspondência exata de UID e e-mail do Root Admin (assume request.auth presente).
    function isRootIdentity() {
      let tok = request.auth.token;
      return request.auth.uid == 'hCG5mDgK1fRaTojULzlM7dXvb7n2' &&
             ('email' in tok) &&
             tok.email != null &&
             tok.email.lower() == 'paulocauan39@gmail.com';
    }

    // Verifica identidade completa do Root Admin (autenticado + e-mail verificado + UID/e-mail fixos).
    function isRootAdmin() {
      return isSignedIn() &&
             isEmailVerified() &&
             request.auth.uid == 'hCG5mDgK1fRaTojULzlM7dXvb7n2' &&
             ('email' in request.auth.token) &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'paulocauan39@gmail.com';
    }

    // Claims administrativas emitidas pelo Firebase Admin SDK. Se o perfil existir
    // em /users/{uid}, o documento precisa concordar (ADMIN + APROVADO); claims
    // obsoletas nunca sobrepõem rebaixamento ou revogação persistida.
    function hasAdminClaim() {
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             (('role' in request.auth.token && request.auth.token.role == 'ADMIN') ||
              ('admin' in request.auth.token && request.auth.token.admin == true)) &&
             (!userDocExists() || isAdminUserDoc());
    }

    // =========================================================================
    // SEÇÃO 5 — STATUS, APROVAÇÃO, SUSPENSÃO E BLOQUEIO DE CONTAS
    // =========================================================================
    // Política fail-closed de regularidade cadastral:
    //   - active == false sempre bloqueia.
    //   - Todo campo de prazo presente (blockExpiresAt / suspendedUntil) DEVE ser
    //     um Timestamp nativo já expirado; null, string ou número bloqueiam.
    //   - Ausência da chave 'status' preserva compatibilidade legada ('active').
    //   - status == 'suspended' sem prazo válido (suspensão indefinida) permanece bloqueado.
    //   - status == 'banned', null, vazio ou desconhecido permanece bloqueado.

    // Avalia a situação operacional (regularidade e prazos) a partir do mapa do usuário.
    function isStandingActive(u) {
      let hasB = 'blockExpiresAt' in u;
      let hasS = 'suspendedUntil' in u;
      let statusVal = ('status' in u) ? u.status : 'active';
      return (!('active' in u) || u.active != false) &&
             (!hasB || (u.blockExpiresAt is timestamp && request.time >= u.blockExpiresAt)) &&
             (!hasS || (u.suspendedUntil is timestamp && request.time >= u.suspendedUntil)) &&
             (statusVal == 'active' || (statusVal == 'suspended' && hasS));
    }

    // Verifica se o documento de usuário não é INTRUSO e está em situação ativa regular.
    function isUserDocActiveData(u) {
      return (!('role' in u) || u.role != 'INTRUSO') && isStandingActive(u);
    }

    // Indica se o documento /users/{uid} do solicitante está bloqueado/suspenso/banido.
    function isUserDocBlocked() {
      return !isStandingActive(getUserData());
    }

    // Indica se a conta autenticada possui perfil existente em estado de bloqueio.
    function isAccountBlocked() {
      return isSignedIn() &&
             userDocExists() &&
             isUserDocBlocked();
    }

    // Indica se o documento /users/{uid} do solicitante está ativo e não é INTRUSO.
    function isUserDocActive() {
      return isUserDocActiveData(getUserData());
    }

    // Indica se a conta autenticada está apta a operar (Root Admin verificado ou perfil ativo).
    function isAccountActive() {
      // (!('active' in getUserData()) || getUserData().active != false)
      return isSignedIn() && (
        (hasVerifiedEmailToken() && isRootIdentity()) || (
          userDocExists() &&
          isUserDocActive()
        )
      );
    }

    // =========================================================================
    // SEÇÃO 6 — IDENTIDADE EFETIVA E GERENCIAMENTO DE CARGOS (/users/{uid})
    // =========================================================================
    // O documento /users/{uid} é a fonte autoritativa para cargos atribuídos por
    // administradores (inclusive para contas externas como Gmail). Helpers
    // parametrizados evitam múltiplas leituras de getUserData() e mantêm o
    // orçamento CEL bem abaixo do limite de 1.000 expressões.

    function hasApprovedAdminRole(u) {
      return ('role' in u) && u.role == 'ADMIN' && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO';
    }

    function hasApprovedServidorRole(u) {
      return ('role' in u) && u.role == 'SERVIDOR' && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO';
    }

    function hasApprovedStaffOrAdminRole(u) {
      return ('role' in u) && (u.role == 'SERVIDOR' || u.role == 'ADMIN') && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO';
    }

    function isAdminUserDoc() {
      let u = getUserData();
      return ('role' in u) && u.role == 'ADMIN' && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO';
    }

    function isActiveAdminDoc() {
      let u = getUserData();
      return isUserDocActiveData(u) && hasApprovedAdminRole(u);
    }

    function isActiveStaffOrAdminDoc() {
      let u = getUserData();
      return isUserDocActiveData(u) && hasApprovedStaffOrAdminRole(u);
    }

    function isDocAdmin() {
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             userDocExists() &&
             isAdminUserDoc();
    }

    // Administrador efetivo: Root Admin verificado ou ADMIN aprovado e ativo em /users/{uid}.
    function isAdmin() {
      return isSignedIn() && hasVerifiedEmailToken() && (
        isRootIdentity() ||
        (userDocExists() && isActiveAdminDoc())
      );
    }

    // Identidade de SERVIDOR no documento /users/{uid} (independente de domínio ou claim antiga).
    function isDocServidorIdentity() {
      // O documento Firestore users/{uid} é autoritativo para atribuições administrativas de SERVIDOR.
      // Contas externas (ex: Gmail) aprovadas por administrador não são rejeitadas por claims antigas.
      let u = getUserData();
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             userDocExists() &&
             ('role' in u) &&
             u.role == 'SERVIDOR';
    }

    function isApprovedServidorDoc() {
      let u = getUserData();
      return ('role' in u) && u.role == 'SERVIDOR' && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO';
    }

    // Servidor com e-mail verificado e documento /users/{uid} com role=SERVIDOR e approvalStatus=APROVADO.
    function isDocServidor() {
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             userDocExists() &&
             isApprovedServidorDoc();
    }

    // Servidor aprovado com conta ativa regular.
    function isServidor() {
      return isAccountActive() && isDocServidor();
    }

    // Verifica em leitura única se o usuário é Root Admin ou SERVIDOR/ADMIN aprovado e ativo.
    function isStaffOrAdminActive() {
      return isSignedIn() && hasVerifiedEmailToken() && (
        isRootIdentity() ||
        (userDocExists() && isActiveStaffOrAdminDoc())
      );
    }

    function isApprovedStaffOrAdminDoc() {
      let u = getUserData();
      return ('role' in u) && (u.role == 'SERVIDOR' || u.role == 'ADMIN') && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO';
    }

    // Verifica elegibilidade para cadastro de objetos (SERVIDOR aprovado ou ADMIN autorizado).
    function canRegisterItems() {
      // Contas aprovadas como SERVIDOR (institucionais ou externas atribuídas por administrador) e administradores
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             (
               (userDocExists() && isApprovedStaffOrAdminDoc()) ||
               hasAdminClaim() ||
               isRootIdentity()
             );
    }

    // Verifica se o documento possui papel institucional/atribuído reconhecido (ALUNO, SERVIDOR ou ADMIN aprovado).
    function isRecognizedUserDocRoleData(u) {
      return ('role' in u) && (
        u.role == 'ALUNO' ||
        u.role == 'SERVIDOR' ||
        (u.role == 'ADMIN' && ('approvalStatus' in u) && u.approvalStatus == 'APROVADO')
      );
    }

    // Determina se o usuário do documento não é INTRUSO (papel reconhecido no doc OU e-mail institucional).
    function isNonIntrusoRoleOrEmail(u) {
      let tok = request.auth.token;
      let hasEmail = ('email' in tok) && tok.email != null;
      let lowerEmail = hasEmail ? tok.email.lower() : '';
      return isRecognizedUserDocRoleData(u) || (
        (!('role' in u) || u.role != 'INTRUSO') &&
        (!hasEmail || isLowerInstStudentEmail(lowerEmail) || isLowerInstStaffEmail(lowerEmail))
      );
    }

    function isActiveNonIntrusoDoc() {
      let u = getUserData();
      return isUserDocActiveData(u) && isNonIntrusoRoleOrEmail(u);
    }

    // Membro ativo com e-mail verificado e não-INTRUSO (Root Admin ou perfil reconhecido ativo).
    function isActiveVerifiedMember() {
      return isSignedIn() && hasVerifiedEmailToken() && (
        isRootIdentity() ||
        (userDocExists() && isActiveNonIntrusoDoc())
      );
    }

    // Classifica conta autenticada como INTRUSO quando não verificada ou sem vínculo/atribuição válida.
    function isIntruso() {
      let tok = request.auth.token;
      let hasEmail = ('email' in tok) && tok.email != null;
      let lowerEmail = hasEmail ? tok.email.lower() : '';
      let hasDoc = userDocExists();
      return isSignedIn() && (
        !hasVerifiedEmailToken() ||
        (
          !isRootIdentity() &&
          (
            hasDoc
              ? !isNonIntrusoRoleOrEmail(getUserData())
              : (
                  !((('role' in tok && tok.role == 'ADMIN') || ('admin' in tok && tok.admin == true))) &&
                  hasEmail &&
                  !isLowerInstStudentEmail(lowerEmail) &&
                  !isLowerInstStaffEmail(lowerEmail)
                )
          )
        )
      );
    }

    // =========================================================================
    // SEÇÃO 7 — VALIDAÇÃO DE DADOS, LIMITES E PROTEÇÃO DE CAMPOS DE OBJETOS
    // =========================================================================

    // Limites defensivos de tamanho para campos textuais de objetos (SEC-04).
    function isValidItemTextFields(data) {
      return (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('color' in data) || data.color == null || (data.color is string && data.color.size() <= 50)) &&
             (!('brand' in data) || data.brand == null || (data.brand is string && data.brand.size() <= 60)) &&
             (!('contactInfo' in data) || data.contactInfo == null || (data.contactInfo is string && data.contactInfo.size() <= 150)) &&
             (!('contact' in data) || data.contact == null || (data.contact is string && data.contact.size() <= 150)) &&
             (!('aiPrompt' in data) || data.aiPrompt == null || (data.aiPrompt is string && data.aiPrompt.size() <= 500));
    }

    // ETAPA 11 & ETAPA 15: Proteção estrita dos 40 campos privados de devolução
    // formal, assinaturas, comprovantes, PII, tokens e dicas secretas.
    // Escrita exclusiva pelo Firebase Admin SDK em /item_return_records ou em
    // /item_private; nunca podem ser injetados ou expostos no catálogo público.
    function hasNoReturnOrSignatureFields(data) {
      return !data.keys().hasAny([
        'returnedByUserId',
        'returnedByName',
        'returnedByRole',
        'returnDate',
        'returnTime',
        'recipientName',
        'recipientEmail',
        'recipientBond',
        'recipientDocument',
        'recipientUid',
        'returnObservations',
        'receiptValidationCode',
        'recipientSignatureUrl',
        'recipientSignatureType',
        'recipientSignatureMethod',
        'recipientSignatureStatus',
        'recipientSignatureEmail',
        'recipientSignatureName',
        'recipientSignatureBond',
        'recipientSignatureDate',
        'staffSignatureStatus',
        'staffSignatureUrl',
        'staffSignatureMethod',
        'staffSignedAt',
        'staffSignerUid',
        'staffSignerName',
        'staffSignerEmail',
        'signatureToken',
        'signatureTokenExpiresAt',
        'signatureTokenUsed',
        'signedAt',
        'signatureIpOrDevice',
        'secretVerificationKey',
        'secretVerificationHint',
        'requiresAdminClaimReview',
        'devolutionNotified',
        'returnEmailNotified',
        'devolutionNotificationStatus',
        'devolutionNotifiedAt',
        'devolutionNotifiedBy'
      ]);
    }

    // Bloqueia qualquer tentativa de inserir, alterar ou remover os 40 campos
    // protegidos de devolução, assinatura ou verificação secreta em updates.
    function hasNoProtectedReturnOrSignatureMutation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'returnedByUserId',
        'returnedByName',
        'returnedByRole',
        'returnDate',
        'returnTime',
        'recipientName',
        'recipientEmail',
        'recipientBond',
        'recipientDocument',
        'recipientUid',
        'returnObservations',
        'receiptValidationCode',
        'recipientSignatureUrl',
        'recipientSignatureType',
        'recipientSignatureMethod',
        'recipientSignatureStatus',
        'recipientSignatureEmail',
        'recipientSignatureName',
        'recipientSignatureBond',
        'recipientSignatureDate',
        'staffSignatureStatus',
        'staffSignatureUrl',
        'staffSignatureMethod',
        'staffSignedAt',
        'staffSignerUid',
        'staffSignerName',
        'staffSignerEmail',
        'signatureToken',
        'signatureTokenExpiresAt',
        'signatureTokenUsed',
        'signedAt',
        'signatureIpOrDevice',
        'secretVerificationKey',
        'secretVerificationHint',
        'requiresAdminClaimReview',
        'devolutionNotified',
        'returnEmailNotified',
        'devolutionNotificationStatus',
        'devolutionNotifiedAt',
        'devolutionNotifiedBy'
      ]);
    }

    // Garante imutabilidade dos campos centrais de autoria e identificação do objeto.
    function areItemCoreImmutableFieldsPreserved() {
      return (!('registeredByUserId' in existing()) || incoming().registeredByUserId == existing().registeredByUserId) &&
             (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
             (!('registeredByRole' in existing()) || incoming().registeredByRole == existing().registeredByRole) &&
             (!('type' in existing()) || incoming().type == existing().type) &&
             (!('id' in existing()) || incoming().id == existing().id);
    }

    // Edição segura de metadados pelo autor do objeto (sem mudança de status).
    function isAuthorSafeMetadataEdit() {
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             (!('status' in existing()) ? !('status' in incoming()) : incoming().status == existing().status) &&
             ('registeredByUserId' in existing()) &&
             existing().registeredByUserId == request.auth.uid &&
             isActiveVerifiedMember() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title',
               'description',
               'category',
               'location',
               'date',
               'color',
               'brand',
               'contactInfo',
               'imageUrl',
               'additionalImages',
               'lastEditedByUserId',
               'lastEditedByName',
               'lastEditedByRole',
               'lastEditedAt'
             ]);
    }

    // Atualização operacional por SERVIDOR aprovado ou ADMIN ativo.
    // Proíbe marcar status como DEVOLVIDO pelo cliente (fluxo exclusivo Admin SDK)
    // e exige destinationType + destinationReason preenchidos para status ENCERRADO.
    function isStaffOrAdminNonReturnItemUpdate() {
      return (!('status' in incoming()) || incoming().status != 'DEVOLVIDO') &&
             isStaffOrAdminActive() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title',
               'description',
               'category',
               'location',
               'date',
               'color',
               'brand',
               'contactInfo',
               'imageUrl',
               'additionalImages',
               'status',
               'resolutionDate',
               'destinationType',
               'destinationReason',
               'destinationDate',
               'destinationResponsible',
               'matchedWithItemId',
               'lastEditedByUserId',
               'lastEditedByName',
               'lastEditedByRole',
               'lastEditedAt'
             ]) &&
             (!('status' in incoming()) || incoming().status != 'ENCERRADO' || (
               ('destinationType' in incoming()) &&
               incoming().destinationType is string &&
               incoming().destinationType.size() > 0 &&
               ('destinationReason' in incoming()) &&
               incoming().destinationReason is string &&
               incoming().destinationReason.size() > 0
             ));
    }

    // Verifica se o documento de usuário possui cargo efetivo compatível com o papel declarado no cadastro.
    function isActiveStaffOrAdminForRole(u, role) {
      return isUserDocActiveData(u) &&
             ('approvalStatus' in u) && u.approvalStatus == 'APROVADO' &&
             ('role' in u) && (
               (role == 'ADMIN' && u.role == 'ADMIN') ||
               (role == 'SERVIDOR' && (u.role == 'SERVIDOR' || u.role == 'ADMIN'))
             );
    }

    // Autorização completa para criação de objetos no catálogo (/items, /found_items, /lost_items):
    //   - Exige autenticação, e-mail verificado, registeredByUserId == auth.uid;
    //   - Aceita apenas SERVIDOR aprovado ou ADMIN autorizado (nunca ALUNO ou INTRUSO);
    //   - Bloqueia criação já em DEVOLVIDO/ENCERRADO ou com campos privados de devolução.
    function canCreateCatalogItem() {
      let inc = incoming();
      return isSignedIn() &&
             hasVerifiedEmailToken() &&
             incoming().registeredByUserId == request.auth.uid &&
             (inc.registeredByRole == 'SERVIDOR' || inc.registeredByRole == 'ADMIN') &&
             (!('status' in inc) || (inc.status != 'DEVOLVIDO' && inc.status != 'ENCERRADO')) &&
             hasNoReturnOrSignatureFields(inc) &&
             (
               isRootIdentity() ||
               (
                 userDocExists() &&
                 isActiveStaffOrAdminForRole(getUserData(), inc.registeredByRole)
               )
             );
    }

    // Pré-condição comum para atualização de objetos (impede edição em DEVOLVIDO/ENCERRADO).
    function canUpdateCatalogItemBase() {
      let ext = existing();
      return (!('status' in ext) || (ext.status != 'DEVOLVIDO' && ext.status != 'ENCERRADO')) &&
             areItemCoreImmutableFieldsPreserved() &&
             hasNoProtectedReturnOrSignatureMutation();
    }

    // Autorização para exclusão de objetos ainda não devolvidos:
    //   - ADMIN pode excluir (desde que não DEVOLVIDO);
    //   - Autor ativo pode excluir apenas se não estiver ENCERRADO nem DEVOLVIDO.
    function canDeleteNonReturnedCatalogItem() {
      return isAdmin() || (
        isActiveVerifiedMember() &&
        existing().registeredByUserId == request.auth.uid &&
        (!('status' in existing()) || existing().status != 'ENCERRADO')
      );
    }

    // =========================================================================
    // SEÇÃO 8 — VALIDAÇÃO DE AÇÕES DE AUDITORIA PERMITIDAS NO CLIENTE
    // =========================================================================
    // Ações críticas (devoluções formais, atribuições/revogações de cargos,
    // exclusão de contas, wipe e configurações críticas) só podem ser gravadas
    // pelo backend via Firebase Admin SDK.
    function isAllowedClientAuditAction(data) {
      return 'action' in data &&
             data.action is string &&
             data.action.size() > 0 &&
             !(data.action in [
               'REGISTRO_DEVOLUCAO',
               'REABERTURA_DEVOLUCAO',
               'CONFIRMACAO_NOTIFICACAO_ASSINATURA',
               'REEMISSAO_LINK_ASSINATURA',
               'REENVIO_SOLICITACAO_ASSINATURA',
               'RECUPERACAO_LINK_ASSINATURA',
               'ROLE_ASSIGNED',
               'ROLE_REVOKED',
               'ACCOUNT_DELETED',
               'ACCOUNT_DELETION_INCONSISTENCY',
               'MASTER_WIPE_EXECUTED',
               'UPDATE_SYSTEM_CONFIG',
               'UNAUTHORIZED_AI_ATTEMPT'
             ]);
    }

    // =========================================================================
    // SEÇÃO 9 — ATRIBUIÇÕES DE CARGOS (/role_assignments)
    // =========================================================================
    // Escrita 100% exclusiva do Firebase Admin SDK (backend).
    match /role_assignments/{targetUserId} {
      // Get: o próprio usuário consulta sua atribuição; ADMIN consulta qualquer atribuição.
      allow get: if isSignedIn() && (request.auth.uid == targetUserId || isAdmin());

      // List: exclusivamente ADMIN.
      allow list: if isAdmin();

      // Write: estritamente proibido via Client SDK.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // SEÇÃO 10 — USUÁRIOS (/users)
    // =========================================================================
    // Princípio do menor privilégio, anti-enumeração e proteção contra
    // auto-escalação de privilégios ou remoção de campos de controle.
    match /users/{userId} {
      // Valida criação inicial do próprio documento /users/{uid}.
      // Impede auto-atribuição de ADMIN, admin: true, roleAssignedBy/At ou
      // auto-aprovação de SERVIDOR.
      function canCreateOwnUserDoc() {
        let inc = incoming();
        let tok = request.auth.token;
        let verified = ('email_verified' in tok) && tok.email_verified == true;
        let hasEmail = ('email' in tok) && tok.email != null;
        let lowerTokEmail = hasEmail ? tok.email.lower() : '';
        let emailMatches = hasEmail && (inc.email == tok.email || inc.email.lower() == lowerTokEmail);
        let isAdminCreator = verified && (
          isRootIdentity() ||
          (
            (('role' in tok && tok.role == 'ADMIN') || ('admin' in tok && tok.admin == true)) &&
            (!userDocExists() || isAdminUserDoc())
          )
        );
        return isSignedIn() &&
               request.auth.uid == userId &&
               inc.id == userId &&
               emailMatches &&
               (
                 isAdminCreator ||
                 (
                   (!('admin' in inc) || inc.admin == false) &&
                   !('roleAssignedBy' in inc) &&
                   !('roleAssignedAt' in inc) &&
                   (
                     (inc.role == 'INTRUSO' && inc.approvalStatus in ['PENDENTE', 'APROVADO']) ||
                     (verified && hasEmail && (
                       (inc.role == 'ALUNO' && inc.approvalStatus in ['PENDENTE', 'APROVADO'] && isLowerInstStudentEmail(lowerTokEmail)) ||
                       ((incoming().role == 'SERVIDOR' && isInstitutionalStaffEmail()) && inc.approvalStatus == 'PENDENTE')
                     ))
                   )
                 )
               );
      }

      // Garante imutabilidade de campos de governança e bloqueio em atualizações próprias
      // (impede alteração ou exclusão via FieldValue.delete()).
      function areUserControlFieldsImmutable(ext, inc) {
        return (!('roleAssignedBy' in inc) || ('roleAssignedBy' in ext && inc.roleAssignedBy == ext.roleAssignedBy)) &&
               (!('roleAssignedAt' in inc) || ('roleAssignedAt' in ext && inc.roleAssignedAt == ext.roleAssignedAt)) &&
               (('status' in existing() && incoming().status == existing().status) || (!('status' in ext) && (!('status' in inc) || inc.status == 'active'))) &&
               (('suspendedUntil' in existing() && incoming().suspendedUntil == existing().suspendedUntil) || (!('suspendedUntil' in ext) && !('suspendedUntil' in inc))) &&
               (('blockExpiresAt' in ext && inc.blockExpiresAt == ext.blockExpiresAt) || (!('blockExpiresAt' in ext) && !('blockExpiresAt' in inc))) &&
               (('reputationScore' in ext && inc.reputationScore == ext.reputationScore) || (!('reputationScore' in ext) && (!('reputationScore' in inc) || inc.reputationScore == 100)));
      }

      // 1. Get: usuário lê apenas seu próprio perfil; ADMIN lê qualquer perfil.
      allow get: if isAuthUser(userId) || isAdmin();

      // 2. List: apenas ADMIN enumera usuários; usuário ativo só pode consultar o próprio e-mail.
      allow list: if isAdmin() ||
                     (isSignedIn() && isAccountActive() && resource != null &&
                      (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower()));

      // 3. Create: somente criação do próprio documento com UID e e-mail correspondentes ao token.
      allow create: if canCreateOwnUserDoc();

      // 4. Update:
      //   - ADMIN gerencia perfis, mas promover outro usuário a ADMIN é exclusivo do Root Admin.
      //   - Branch 1: Promoção institucional legítima (INTRUSO -> ALUNO ou SERVIDOR PENDENTE).
      //   - Branch 2: Atualização normal de perfil próprio por conta ativa (cargo e controle imutáveis).
      //   - Branch 3: Inicialização de status='active' para perfis institucionais legados sem 'status'.
      allow update: if (
        (
          isAdmin() && (
            incoming().role != 'ADMIN' || isRootIdentity() || ('role' in existing() && existing().role == 'ADMIN')
          )
        ) || (
          isSignedIn() &&
          request.auth.uid == userId &&
          incoming().id == userId &&
          (incoming().email == existing().email || incoming().email.lower() == existing().email.lower()) &&
          ('role' in existing()) &&
          isStandingActive(existing()) &&
          (
            // Branch 1: Promoção institucional legítima (INTRUSO -> ALUNO ou SERVIDOR)
            (
              existing().role == 'INTRUSO' &&
              (incoming().email == request.auth.token.email || incoming().email.lower() == request.auth.token.email.lower()) &&
              (!('admin' in incoming()) || incoming().admin == false) &&
              (!('admin' in existing()) || existing().admin == false) &&
              areUserControlFieldsImmutable(existing(), incoming()) &&
              (
                (
                  (incoming().role == 'ALUNO' && isInstitutionalStudentEmail()) &&
                  ('approvalStatus' in existing() && incoming().approvalStatus == existing().approvalStatus)
                ) ||
                (incoming().role == 'SERVIDOR' && isInstitutionalStaffEmail() && incoming().approvalStatus == 'PENDENTE')
              )
            ) ||
            // Branch 2: Atualizações normais de perfil próprio por usuários com conta ativa
            (
              existing().role != 'INTRUSO' &&
              incoming().role == existing().role &&
              (!('admin' in incoming()) || incoming().admin == existing().admin) &&
              areUserControlFieldsImmutable(existing(), incoming()) &&
              ('approvalStatus' in existing()) &&
              (incoming().approvalStatus == existing().approvalStatus)
            ) ||
            // Branch 3: Inicialização de status para perfis institucionais legados sem o campo status
            (
              (incoming().email == request.auth.token.email || incoming().email.lower() == request.auth.token.email.lower()) &&
              (existing().role == 'ALUNO' || existing().role == 'SERVIDOR') &&
              incoming().role == existing().role &&
              (!('admin' in incoming()) || incoming().admin == false) &&
              (!('admin' in existing()) || existing().admin == false) &&
              (!('approvalStatus' in existing()) || incoming().approvalStatus == existing().approvalStatus) &&
              (!('status' in existing()) && incoming().status == 'active') &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
              (
                (existing().role == 'ALUNO' && isInstitutionalStudentEmail()) ||
                (existing().role == 'SERVIDOR' && isInstitutionalStaffEmail())
              )
            )
          )
        )
      );

      // 5. Delete: exclusivamente ADMIN (impedido de excluir a própria conta ativa).
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // =========================================================================
    // SEÇÃO 11 — CADASTRO E GERENCIAMENTO DE OBJETOS (/items, /found_items,
    //            /lost_items, /item_private e /item_history)
    // =========================================================================

    // Catálogo principal de achados e perdidos.
    //   - Get/List público: apenas projeções limpas sem campos privados de devolução/assinatura.
    //   - Create: exclusivamente SERVIDOR aprovado ou ADMIN autorizado (ALUNO/INTRUSO bloqueados).
    //   - Update: SERVIDOR/ADMIN (exceto DEVOLVIDO) ou edição segura de metadados pelo autor.
    //   - Delete: nunca para itens DEVOLVIDO; ADMIN ou autor ativo (se não ENCERRADO).
    match /items/{itemId} {
      allow get: if resource == null || hasNoReturnOrSignatureFields(resource.data) || (isSignedIn() && isAccountActive() && (isAdmin() || isServidor()));
      allow list: if isStaffOrAdminActive() || hasNoReturnOrSignatureFields(resource.data);
      allow create: if isValidItemTextFields(incoming()) && canCreateCatalogItem();
      allow update: if isValidItemTextFields(incoming()) && canUpdateCatalogItemBase() && (isStaffOrAdminNonReturnItemUpdate() || isAuthorSafeMetadataEdit());
      allow delete: if (!('status' in existing()) || existing().status != 'DEVOLVIDO') && canDeleteNonReturnedCatalogItem();
    }

    // Coleção de objetos encontrados (mesma política de segurança de /items).
    match /found_items/{itemId} {
      allow get: if resource == null || hasNoReturnOrSignatureFields(resource.data) || (isSignedIn() && isAccountActive() && (isAdmin() || isServidor()));
      allow list: if isStaffOrAdminActive() || hasNoReturnOrSignatureFields(resource.data);
      allow create: if isValidItemTextFields(incoming()) && canCreateCatalogItem();
      allow update: if isValidItemTextFields(incoming()) && canUpdateCatalogItemBase() && (isStaffOrAdminNonReturnItemUpdate() || isAuthorSafeMetadataEdit());
      allow delete: if (!('status' in existing()) || existing().status != 'DEVOLVIDO') && canDeleteNonReturnedCatalogItem();
    }

    // Coleção de objetos perdidos (mesma política de segurança de /items).
    match /lost_items/{itemId} {
      allow get: if resource == null || hasNoReturnOrSignatureFields(resource.data) || (isSignedIn() && isAccountActive() && (isAdmin() || isServidor()));
      allow list: if isStaffOrAdminActive() || hasNoReturnOrSignatureFields(resource.data);
      allow create: if isValidItemTextFields(incoming()) && canCreateCatalogItem();
      allow update: if isValidItemTextFields(incoming()) && canUpdateCatalogItemBase() && (isStaffOrAdminNonReturnItemUpdate() || isAuthorSafeMetadataEdit());
      allow delete: if (!('status' in existing()) || existing().status != 'DEVOLVIDO') && canDeleteNonReturnedCatalogItem();
    }

    // Dicas e chaves secretas de verificação de objetos (dados restritos à equipe/autor).
    match /item_private/{itemId} {
      // Get: apenas SERVIDOR aprovado ativo, ADMIN ativo ou autor do objeto.
      allow get: if isStaffOrAdminActive() || (
        isSignedIn() && isAccountActive() && (
          (resource != null && 'registeredByUserId' in resource.data && resource.data.registeredByUserId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/items/$(itemId)) &&
           get(/databases/$(database)/documents/items/$(itemId)).data.registeredByUserId == request.auth.uid)
        )
      );

      // List: exclusivamente SERVIDOR aprovado ativo ou ADMIN ativo.
      allow list: if isStaffOrAdminActive();

      // Create / Update: exclusivamente SERVIDOR aprovado ativo ou ADMIN ativo.
      allow create: if isStaffOrAdminActive() &&
                       (!('itemId' in incoming()) || incoming().itemId == itemId);
      allow update: if isStaffOrAdminActive() &&
                       (!('registeredByUserId' in existing()) || incoming().registeredByUserId == existing().registeredByUserId) &&
                       (!('itemId' in incoming()) || incoming().itemId == itemId);

      // Delete: ADMIN ou autor ativo enquanto o item não estiver DEVOLVIDO.
      allow delete: if isAdmin() || (
        isActiveVerifiedMember() &&
        exists(/databases/$(database)/documents/items/$(itemId)) &&
        get(/databases/$(database)/documents/items/$(itemId)).data.registeredByUserId == request.auth.uid &&
        get(/databases/$(database)/documents/items/$(itemId)).data.status != 'DEVOLVIDO'
      );
    }

    // Linha do tempo imutável (append-only) de eventos dos objetos.
    match /item_history/{entryId} {
      // Valida permissão de criação do registro conforme o cargo real do documento /users/{uid}.
      function canUserDocCreateItemHistory(inc, u) {
        let hasRoleField = 'actorRole' in inc;
        let isAdm = hasApprovedAdminRole(u);
        let isServ = hasApprovedServidorRole(u);
        let itemPath = /databases/$(database)/documents/items/$(inc.objectId);
        return isUserDocActiveData(u) && (
          (isAdm && (!hasRoleField || inc.actorRole in ['ADMIN', 'SERVIDOR'])) ||
          (isServ && (!hasRoleField || inc.actorRole == 'SERVIDOR')) ||
          (
            isNonIntrusoRoleOrEmail(u) &&
            (!hasRoleField || inc.actorRole == 'ALUNO') &&
            exists(itemPath) &&
            get(itemPath).data.registeredByUserId == request.auth.uid
          )
        );
      }

      // Get: público apenas para documentos limpos (sem campos privados/PII);
      // SERVIDOR aprovado e ADMIN leem integralmente.
      allow get: if resource == null ||
                    isStaffOrAdminActive() ||
                    hasNoReturnOrSignatureFields(resource.data);

      // List: estritamente restrita a SERVIDOR aprovado ativo e ADMIN ativo.
      allow list: if isStaffOrAdminActive();

      // Create: append-only por usuário autenticado, verificado e sem escalação de actorRole.
      allow create: if isSignedIn() &&
                       hasVerifiedEmailToken() &&
                       incoming().actorId == request.auth.uid &&
                       incoming().objectId is string &&
                       incoming().objectId.size() > 0 &&
                       incoming().action is string &&
                       incoming().action.size() > 0 &&
                       hasNoReturnOrSignatureFields(incoming()) &&
                       (
                         (isRootIdentity() && (!('actorRole' in incoming()) || incoming().actorRole in ['ADMIN', 'SERVIDOR'])) ||
                         (userDocExists() && canUserDocCreateItemHistory(incoming(), getUserData()))
                       );

      // Imutabilidade absoluta: entradas de histórico nunca podem ser alteradas ou excluídas.
      allow update, delete: if false;
    }

    // =========================================================================
    // SEÇÃO 12 — ASSINATURAS, COMPROVANTES E REGISTROS PRIVADOS DE DEVOLUÇÃO
    //            (/signature_requests e /item_return_records)
    // =========================================================================

    // Solicitações e tokens de assinatura digital: acesso 100% bloqueado no Client SDK.
    // Operado exclusivamente no backend via Firebase Admin SDK.
    match /signature_requests/{itemId} {
      allow read, write: if false;
    }

    // Registros formais privados de devolução, PII do recebedor, assinaturas e comprovantes.
    // Escrita 100% exclusiva do backend via Firebase Admin SDK.
    match /item_return_records/{itemId} {
      // Get: apenas ADMIN, SERVIDOR aprovado ativo ou o próprio destinatário (recipientUid).
      allow get: if isSignedIn() && isAccountActive() && (
        isAdmin() ||
        isServidor() ||
        (resource != null && 'recipientUid' in resource.data && resource.data.recipientUid == request.auth.uid)
      );

      // List: apenas ADMIN ou SERVIDOR aprovado ativo.
      allow list: if isSignedIn() && isAccountActive() && (isAdmin() || isServidor());

      // Write: estritamente proibido via Client SDK.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // SEÇÃO 13 — SOLICITAÇÕES DE DEVOLUÇÃO (/claims)
    // =========================================================================
    // Ciclo de vida protegido com ID determinístico (claim_{uid}_{itemId}),
    // titularidade estrita, imutabilidade de campos principais e proibição de
    // injeção de metadados de revisão administrativa.
    match /claims/{claimId} {
      // Garante ausência de campos de revisão administrativa na criação/reenvio.
      function hasNoAdminReviewFields(data) {
        return !('reviewedByUserId' in data) &&
               !('reviewedByName' in data) &&
               !('reviewedByRole' in data) &&
               !('reviewedAt' in data) &&
               !('rejectionReason' in data) &&
               !('decisionNotes' in data) &&
               !('completedAt' in data) &&
               !('cancelledAt' in data);
      }

      // Garante preservação dos campos imutáveis durante revisões da secretaria.
      function areImmutableFieldsPreserved() {
        return incoming().id == existing().id &&
               incoming().itemId == existing().itemId &&
               incoming().claimerId == existing().claimerId &&
               incoming().createdAt == existing().createdAt &&
               incoming().distinctiveFeatures == existing().distinctiveFeatures;
      }

      // Garante que o objeto associado existe no catálogo e não está DEVOLVIDO nem ENCERRADO.
      function isClaimableItem(itemId) {
        let itemPath = /databases/$(database)/documents/items/$(itemId);
        return exists(itemPath) && !(get(itemPath).data.status in ['DEVOLVIDO', 'ENCERRADO']);
      }

      // Valida limites textuais da reivindicação e elegibilidade do objeto associado.
      function isValidClaimBody(inc) {
        return inc.distinctiveFeatures is string &&
               inc.distinctiveFeatures.size() > 0 &&
               inc.distinctiveFeatures.size() <= 1000 &&
               (!('additionalInfo' in inc) || inc.additionalInfo == null || (inc.additionalInfo is string && inc.additionalInfo.size() <= 1000)) &&
               isClaimableItem(inc.itemId);
      }

      // Valida transições oficiais do ciclo de vida executadas por SERVIDOR/ADMIN:
      //   - Estados terminais (CONCLUIDO, CANCELADO) são imutáveis.
      //   - PENDENTE -> APROVADO | REJEITADO | CANCELADO
      //   - APROVADO -> CONCLUIDO | REJEITADO
      //   - REJEITADO -> APROVADO (reavaliação presencial)
      //   - REJEITADO exige rejectionReason; CONCLUIDO exige completedAt.
      function isValidStaffClaimTransition(ext, inc) {
        return areImmutableFieldsPreserved() &&
               ext.status != 'CONCLUIDO' &&
               ext.status != 'CANCELADO' &&
               (
                 (ext.status == 'PENDENTE' && inc.status in ['APROVADO', 'REJEITADO', 'CANCELADO']) ||
                 (ext.status == 'APROVADO' && inc.status in ['CONCLUIDO', 'REJEITADO']) ||
                 (ext.status == 'REJEITADO' && inc.status == 'APROVADO') ||
                 (inc.status == ext.status && ext.status in ['PENDENTE', 'APROVADO'])
               ) &&
               (inc.status != 'REJEITADO' || (inc.rejectionReason is string && inc.rejectionReason.size() > 0)) &&
               (inc.status != 'CONCLUIDO' || (inc.completedAt is string && inc.completedAt.size() > 0));
      }

      // Avalia os 3 caminhos válidos de atualização de reivindicação com leitura única de /users/{uid}.
      function canUserDocUpdateClaim(u, ext, inc) {
        let isNonIntruso = isNonIntrusoRoleOrEmail(u);
        return isUserDocActiveData(u) && (
          // 1. Cancelamento pelo solicitante (apenas de PENDENTE -> CANCELADO, somente status e cancelledAt)
          (
            isNonIntruso &&
            ext.claimerId == request.auth.uid &&
            ext.status == 'PENDENTE' &&
            inc.status == 'CANCELADO' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          ) ||
          // 2. Reenvio pelo solicitante (somente se anterior for CANCELADO ou REJEITADO, reinicia em PENDENTE)
          (
            isNonIntruso &&
            ext.claimerId == request.auth.uid &&
            ext.status in ['CANCELADO', 'REJEITADO'] &&
            inc.status == 'PENDENTE' &&
            inc.id == ext.id &&
            inc.claimerId == request.auth.uid &&
            inc.itemId == ext.itemId &&
            inc.createdAt == ext.createdAt &&
            hasNoAdminReviewFields(inc) &&
            isValidClaimBody(inc)
          ) ||
          // 3. Revisão e transições administrativas por SERVIDOR aprovado ou ADMIN
          (
            hasApprovedStaffOrAdminRole(u) &&
            isValidStaffClaimTransition(ext, inc)
          )
        );
      }

      // Get:
      //   1. Leitura transacional tolerante (resource == null) exclusiva para ID determinístico do próprio usuário;
      //   2. Documentos existentes: apenas titular (claimerId), autor do objeto, SERVIDOR aprovado ou ADMIN.
      allow get: if isSignedIn() && (
        (resource == null && isAccountActive() && request.auth.uid != null && claimId.matches('claim_' + request.auth.uid + '_.*')) ||
        isRootAdmin() ||
        (
          isAccountActive() && (
            (resource != null && (
              existing().claimerId == request.auth.uid ||
              (exists(/databases/$(database)/documents/items/$(existing().itemId)) &&
               get(/databases/$(database)/documents/items/$(existing().itemId)).data.registeredByUserId == request.auth.uid)
            )) ||
            (hasVerifiedEmailToken() && (isApprovedServidorDoc() || isAdminUserDoc()))
          )
        )
      );

      // List: ADMIN e SERVIDOR aprovado listam todas; demais usuários ativos listam apenas as próprias (claimerId == uid).
      allow list: if isSignedIn() && (
        isRootAdmin() ||
        (
          isAccountActive() && (
            resource.data.claimerId == request.auth.uid ||
            (hasVerifiedEmailToken() && (isApprovedServidorDoc() || isAdminUserDoc()))
          )
        )
      );

      // Create: membro ativo verificado, ID determinístico, status inicial PENDENTE e objeto elegível.
      allow create: if isActiveVerifiedMember() &&
                    claimId == 'claim_' + request.auth.uid + '_' + incoming().itemId &&
                    incoming().claimerId == request.auth.uid &&
                    incoming().status == 'PENDENTE' &&
                    incoming().itemId is string && incoming().itemId.size() > 0 &&
                    hasNoAdminReviewFields(incoming()) &&
                    isValidClaimBody(incoming());

      // Update: Root Admin (revisão) ou caminhos autorizados em canUserDocUpdateClaim().
      allow update: if isSignedIn() &&
                       hasVerifiedEmailToken() &&
                       (
                         (isRootIdentity() && isValidStaffClaimTransition(existing(), incoming())) ||
                         (userDocExists() && canUserDocUpdateClaim(getUserData(), existing(), incoming()))
                       );

      // Delete: exclusivamente ADMIN.
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SEÇÃO 14 — NOTIFICAÇÕES, COMUNICAÇÕES E INTERAÇÕES
    //            (/notifications, /email_notifications, /fcm_subscriptions,
    //             /comments e /support_tickets)
    // =========================================================================

    // Notificações individuais e comunicados globais (broadcasts).
    match /notifications/{notificationId} {
      // 1. Get: destinatário da notificação, broadcasts autorizados ou ADMIN.
      allow get: if isSignedIn() && (
        (resource != null && (
          existing().userId == request.auth.uid ||
          existing().userId == 'all' ||
          existing().userId == 'todos_alunos' ||
          existing().userId == 'todos' ||
          existing().isGlobal == true
        )) ||
        isAdmin()
      );

      // 2. List: ADMIN consulta todas; usuário consulta apenas suas próprias ou broadcasts.
      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == 'all' ||
          resource.data.userId == 'todos_alunos' ||
          resource.data.userId == 'todos' ||
          resource.data.isGlobal == true
        ))
      );

      // 3. Create: ADMIN/SERVIDOR ativo criam para qualquer destinatário ou broadcast;
      //    usuário regular ativo cria somente para si (sem broadcast e sem tipo SYSTEM).
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isServidor() && isAccountActive()) ||
        (
          isAccountActive() &&
          incoming().userId == request.auth.uid &&
          (!('isGlobal' in incoming()) || incoming().isGlobal != true) &&
          incoming().userId != 'all' &&
          incoming().userId != 'todos' &&
          incoming().userId != 'todos_alunos' &&
          incoming().userId != 'todos_servidores' &&
          incoming().userId != 'global' &&
          (!('type' in incoming()) || incoming().type != 'SYSTEM') &&
          incoming().read == false
        )
      );

      // 4. Update: usuário ativo só pode marcar a própria notificação como lida
      //    (apenas campos read/readAt mutáveis; conteúdo e destinatário imutáveis) ou ADMIN.
      allow update: if (
        isSignedIn() &&
        isAccountActive() &&
        existing().userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        incoming().userId == existing().userId &&
        incoming().title == existing().title &&
        incoming().message == existing().message &&
        (!('type' in existing()) || incoming().type == existing().type) &&
        (!('isGlobal' in existing()) || incoming().isGlobal == existing().isGlobal) &&
        (!('timestamp' in existing()) || incoming().timestamp == existing().timestamp) &&
        (!('relatedItemId' in existing()) || incoming().relatedItemId == existing().relatedItemId) &&
        (!('id' in existing()) || incoming().id == existing().id)
      ) || isAdmin();

      // 5. Delete: próprio usuário ativo ou ADMIN.
      allow delete: if isSignedIn() && (
        isAccountActive() && existing().userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Logs de envio de e-mail transacional: leitura por ADMIN/SERVIDOR ativo;
    // escrita 100% exclusiva do backend via Firebase Admin SDK.
    match /email_notifications/{notifId} {
      allow get, list: if isSignedIn() && isAccountActive() && (isAdmin() || isServidor());
      allow create, update, delete: if false;
    }

    // Inscrições de notificações push (FCM): isoladas por UID ou ADMIN.
    match /fcm_subscriptions/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (request.auth.uid == userId && isActiveVerifiedMember());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId && isAccountActive());
    }

    // Comentários em ocorrências: leitura para autenticados; escrita com anti-spoofing de papel.
    match /comments/{commentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isAccountActive() &&
                       incoming().userId == request.auth.uid &&
                       (
                         (!('userRole' in incoming())) ||
                         (incoming().userRole == 'ALUNO') ||
                         (incoming().userRole == 'SERVIDOR' && isServidor()) ||
                         (incoming().userRole == 'ADMIN' && isAdmin())
                       );
      allow update: if isSignedIn() &&
                       isAccountActive() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().itemId == existing().itemId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('userRole' in incoming()) || incoming().userRole == existing().userRole);
      allow delete: if isAdmin() || (isSignedIn() && isAccountActive() && existing().userId == request.auth.uid);
    }

    // Chamados de suporte e feedback: abertura por visitante (anônimo limpo) ou usuário ativo;
    // leitura restrita ao autor/ADMIN; triagem e exclusão exclusivas de ADMIN.
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && ((resource != null && resource.data.userId == request.auth.uid) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && isAccountActive() && resource != null && resource.data.userId == request.auth.uid);
      allow create: if (
        (isSignedIn() &&
         isAccountActive() &&
         incoming().userId == request.auth.uid &&
         (!('email' in incoming()) || incoming().email == request.auth.token.email) &&
         incoming().status == 'NOVO') ||
        (!isSignedIn() &&
         (!('userId' in incoming()) || incoming().userId == null || incoming().userId == '') &&
         (!('userRole' in incoming()) || incoming().userRole == null) &&
         incoming().status == 'NOVO')
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SEÇÃO 15 — CONFIGURAÇÕES ADMINISTRATIVAS E DOCUMENTOS INSTITUCIONAIS
    //            (/system, /system_config, /project_settings,
    //             /document_templates e /generated_documents)
    // =========================================================================

    // Estado público do banner de modo de manutenção; escrita exclusiva de ADMIN.
    match /system/{docId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    // Configuração protegida de pinning do Root Admin: leitura apenas ADMIN;
    // escrita 100% exclusiva do Firebase Admin SDK.
    match /system_config/{configId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Configurações gerais do projeto (exclusivo ADMIN).
    match /project_settings/{settingsId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Modelos institucionais de documentos (exclusivo ADMIN).
    match /document_templates/{templateId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Documentos institucionais gerados (exclusivo ADMIN).
    match /generated_documents/{docId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SEÇÃO 16 — LOGS, AUDITORIA E TELEMETRIA
    //            (/activity_logs, /audit_logs, /backup_logs,
    //             /error_logs e /system_metrics)
    // =========================================================================

    // Trilha de transparência de atividades (append-only, estritamente imutável).
    // Bloqueia falsificação de actorId/adminId/email, escalação de papel e ações exclusivas do backend.
    match /activity_logs/{logId} {
      allow get: if isAdmin() || (isServidor() && isAccountActive());
      allow list: if isAdmin() || (isServidor() && isAccountActive());
      allow create: if isSignedIn() && (isAccountActive() || isAdmin()) &&
        isAllowedClientAuditAction(incoming()) &&
        (
          (!('actorId' in incoming()) || incoming().actorId == request.auth.uid) &&
          (!('adminId' in incoming()) || incoming().adminId == request.auth.uid) &&
          (!('actorEmail' in incoming()) || request.auth.token.email == null || incoming().actorEmail == request.auth.token.email) &&
          (!('adminEmail' in incoming()) || request.auth.token.email == null || incoming().adminEmail == request.auth.token.email) &&
          (
            (isAdmin() && (!('actorRole' in incoming()) || incoming().actorRole in ['ADMIN', 'SERVIDOR'])) ||
            (isServidor() && isAccountActive() && (!('actorRole' in incoming()) || incoming().actorRole == 'SERVIDOR')) ||
            (
              (incoming().actorRole == 'ALUNO' || incoming().userRole == 'ALUNO') &&
              incoming().action in ['CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM']
            )
          )
        );
      allow update: if false;
      allow delete: if false;
    }

    // Trilha institucional de auditoria (append-only, estritamente imutável).
    match /audit_logs/{logId} {
      allow get: if isAdmin() || (isServidor() && isAccountActive());
      allow list: if isAdmin() || (isServidor() && isAccountActive());
      allow create: if isSignedIn() && (isAccountActive() || isAdmin()) &&
        isAllowedClientAuditAction(incoming()) &&
        incoming().actorId == request.auth.uid &&
        (request.auth.token.email == null || incoming().actorEmail == request.auth.token.email) &&
        (
          (isAdmin() && incoming().actorRole in ['ADMIN', 'SERVIDOR']) ||
          (isServidor() && isAccountActive() && incoming().actorRole == 'SERVIDOR') ||
          (
            incoming().actorRole == 'ALUNO' &&
            incoming().objectType == 'ITEM' &&
            incoming().action in ['CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM']
          )
        );
      allow update: if false;
      allow delete: if false;
    }

    // Registros de backup administrativo (sem alteração após criação).
    match /backup_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && incoming().adminId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Registros de erros de aplicação: leitura por ADMIN/SERVIDOR; criação por usuário ativo sem spoofing;
    // atualização bloqueada; exclusão apenas ADMIN.
    match /error_logs/{logId} {
      allow get: if isAdmin() || isServidor();
      allow list: if isAdmin() || isServidor();
      allow create: if isSignedIn() &&
                       isAccountActive() &&
                       (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
                       (!('userEmail' in incoming()) || request.auth.token.email == null || incoming().userEmail == request.auth.token.email);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Métricas de saúde do sistema: leitura/escrita apenas ADMIN, exceto sonda 'heartbeat'.
    match /system_metrics/{metricId} {
      allow get: if isAdmin() || (isSignedIn() && metricId == 'heartbeat');
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isSignedIn() && isAccountActive() && metricId == 'heartbeat');
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SEÇÃO 17 — GOVERNANÇA DE BATERIA DE TESTES E QA
    //            (/test_executions, /test_participants e /test_error_logs)
    // =========================================================================

    // Execuções de baterias de teste: leitura/atualização por ADMIN, SERVIDOR ou participante designado;
    // criação por ADMIN/SERVIDOR; exclusão apenas ADMIN.
    match /test_executions/{executionId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        isServidor() ||
        exists(/databases/$(database)/documents/test_participants/$(request.auth.uid))
      );
      allow create: if isAdmin() || isServidor();
      allow update: if (isAdmin() || isServidor() || (
        isSignedIn() &&
        isAccountActive() &&
        exists(/databases/$(database)/documents/test_participants/$(request.auth.uid))
      ));
      allow delete: if isAdmin();
    }

    // Registro de participantes autorizados nas baterias de QA.
    match /test_participants/{participantId} {
      allow get: if isSignedIn() && (request.auth.uid == participantId || isAdmin() || isServidor());
      allow list: if isAdmin() || isServidor();
      allow create, update: if isAdmin() || isServidor();
      allow delete: if isAdmin();
    }

    // Logs centralizados de falhas de QA: leitura ADMIN/SERVIDOR; criação com validação estrita de schema;
    // atualização bloqueada (imutável); exclusão apenas ADMIN.
    match /test_error_logs/{logId} {
      allow get, list: if isAdmin() || isServidor();
      allow create: if isSignedIn() &&
                       isAccountActive() &&
                       incoming().batteryId is string && incoming().batteryId.size() > 0 && incoming().batteryId.size() <= 100 &&
                       incoming().testId is string && incoming().testId.size() > 0 && incoming().testId.size() <= 100 &&
                       incoming().action is string && incoming().action.size() > 0 && incoming().action.size() <= 50 &&
                       incoming().errorMessage is string && incoming().errorMessage.size() > 0 && incoming().errorMessage.size() <= 5000 &&
                       incoming().timestamp is string &&
                       (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
                       (!('userEmail' in incoming()) || request.auth.token.email == null || incoming().userEmail == request.auth.token.email);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
