# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DISCORD_FEEDBACK_WEBHOOK_URL: Webhook URL for forwarding user feedback and support tickets to Discord.
# Injected via Cloud Secrets, Firebase Functions config, or Vercel Environment Variables.
# NEVER expose this variable with a VITE_ prefix to keep it strictly on the server-side.
DISCORD_FEEDBACK_WEBHOOK_URL=

# DISCORD_NOVOS_ACHADOS_WEBHOOK_URL: Webhook URL for channel #novos-achados.
# Dispatches automatic Discord Embed notifications when a new found item (ENCONTRADO) is registered.
# Strictly managed server-side via Cloud Secrets / Firebase Functions environment.
DISCORD_NOVOS_ACHADOS_WEBHOOK_URL=

# DISCORD_NOVAS_PERDAS_WEBHOOK_URL: Webhook URL for channel #novas-perdas.
# Dispatches automatic Discord Embed notifications when a new lost item (PERDIDO) is registered.
# Strictly managed server-side via Cloud Secrets / Firebase Functions environment.
# NEVER expose this variable with a VITE_ prefix to keep it strictly on the server-side.
DISCORD_NOVAS_PERDAS_WEBHOOK_URL=

# FIREBASE ADMIN SDK CREDENTIALS (Server-Side / Vercel Only - NEVER expose on frontend)
# Used for backend token verification, Firestore Admin, and secure administrative operations.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# ROOT ADMIN SECURITY PINNING
# ROOT_ADMIN_EMAIL: Official Root Admin email account.
ROOT_ADMIN_EMAIL="paulocauan39@gmail.com"

# ROOT_ADMIN_UID: Firebase Authentication UID of the official Root Admin.
# REQUIRED for Root Admin elevation in server-side operations (e.g., assigning ADMIN role).
# FAIL-CLOSED SECURITY: If this variable is missing or empty in the execution environment,
# Root Admin elevation is strictly disabled. Institutional administrators (@ifpr.edu.br)
# with approved role assignments in Firestore will continue to function normally.
# In production (Cloud Run / Vercel), set this in the environment variables / secrets panel:
# ROOT_ADMIN_UID="hCG5mDgK1fRaTojULzlM7dXvb7n2"
ROOT_ADMIN_UID="hCG5mDgK1fRaTojULzlM7dXvb7n2"

# FIREBASE PERFORMANCE MONITORING (Client-side)
# Defaults to "false". Set to "true" only if Google Firelog telemetry is explicitly required.
VITE_ENABLE_FIREBASE_PERF="false"


