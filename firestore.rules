rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Core Security & Auth Helper Functions
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasAdminClaim() {
      return isSignedIn() && 
             (request.auth.token.role == 'ADMIN' || 
              request.auth.token.admin == true);
    }

    function isRootAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             (request.auth.token.email == 'paulocauan39@gmail.com' ||
              request.auth.token.email.lower() == 'paulocauan39@gmail.com');
    }

    function isDocAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'APROVADO';
    }

    function isAdmin() {
      return hasAdminClaim() || isRootAdmin() || isDocAdmin();
    }

    function isDocServidor() {
      return isSignedIn() && 
             isEmailVerified() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SERVIDOR';
    }

    function isDocAluno() {
      return isSignedIn() && 
             isEmailVerified() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ALUNO';
    }

    function isDocIntruso() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'INTRUSO';
    }

    function isIntruso() {
      return isSignedIn() && (
        !isEmailVerified() ||
        request.auth.token.role == 'INTRUSO' ||
        isDocIntruso() ||
        (!isAdmin() && !isServidor() && !isDocAluno() && request.auth.token.email != null && (
          !request.auth.token.email.matches('.*@estudantes[.]ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@estudante[.]ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@aluno[.]ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@ifpr[.]edu[.]br')
        ))
      );
    }

    function isAccountBlocked() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'banned' ||
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'suspended'
             );
    }

    function isAccountActive() {
      return !isAccountBlocked();
    }

    function isInstitutionalStudentEmail() {
      return isSignedIn() && isEmailVerified() && request.auth.token.email != null && (
        request.auth.token.email.matches('.*@estudantes[.]ifpr[.]edu[.]br') ||
        request.auth.token.email.matches('.*@estudante[.]ifpr[.]edu[.]br') ||
        request.auth.token.email.matches('.*@aluno[.]ifpr[.]edu[.]br')
      );
    }

    function isServidor() {
      return isSignedIn() && 
             (isAdmin() ||
              (isEmailVerified() && (
                (request.auth.token.role == 'SERVIDOR') ||
                isDocServidor() ||
                (!isDocAluno() && request.auth.token.email != null && (
                   request.auth.token.email.matches('.*@ifpr[.]edu[.]br') &&
                   !request.auth.token.email.matches('.*@aluno[.]ifpr[.]edu[.]br') &&
                   !request.auth.token.email.matches('.*@escola[.]ifpr[.]edu[.]br')
                ))
              )));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // 1. Get: User can read their own profile (including when suspended/banned to verify status and reason); Servidores (active) and Admins can read user profiles
      allow get: if isAuthUser(userId) || (isServidor() && isAccountActive()) || isAdmin();

      // 2. List: Only Admins and Active Servidores can list users directory.
      // Individual users can only query specifically by their own authenticated email if account is active.
      // Indiscriminate directory listing by students/unauthorized parties is strictly blocked.
      allow list: if isAdmin() || 
                     (isServidor() && isAccountActive()) || 
                     (isSignedIn() && isAccountActive() && resource.data.email == request.auth.token.email);

      // 3. Create: User can ONLY create their own document with their real UID and email.
      // Privilege escalation prevention:
      // - Cannot set role to 'ADMIN' unless isRootAdmin() or hasAdminClaim()
      // - Cannot set role to 'SERVIDOR' unless isRootAdmin(), hasAdminClaim(), or authorized institutional email
      // - Cannot set approvalStatus to 'APROVADO' unless isRootAdmin() or hasAdminClaim()
      // - Default status is 'active' or pending approval
      allow create: if isSignedIn() && 
                       request.auth.uid == userId && 
                       incoming().id == userId &&
                       incoming().email == request.auth.token.email &&
                       (
                         isRootAdmin() || hasAdminClaim() ||
                         (
                           (
                             incoming().role == 'ALUNO' || 
                             (incoming().role == 'SERVIDOR' && isServidor()) ||
                             incoming().role == 'INTRUSO'
                           ) &&
                           (incoming().approvalStatus == 'PENDENTE' || incoming().approvalStatus == 'APROVADO')
                         )
                       );

      // 4. Update: 
      // - Admins can update any user profile (roles, approvals, departments, account status: active, suspended, banned)
      // - Non-admin users can ONLY update their OWN profile if account is active (isAccountActive()):
      //   * Can keep existing role OR upgrade from INTRUSO to ALUNO/SERVIDOR upon verified institutional email
      //   * Cannot escalate to ADMIN under any circumstances
      //   * Cannot change approvalStatus (incoming.approvalStatus == existing.approvalStatus)
      //   * Cannot change email (incoming.email == existing.email)
      //   * Cannot change ID (incoming.id == userId)
      //   * Cannot change status / suspension fields (anti-tampering)
      allow update: if isAdmin() ||
                       (
                         isSignedIn() && 
                         isAccountActive() &&
                         request.auth.uid == userId && 
                         incoming().id == userId &&
                         incoming().email == existing().email &&
                         (
                           incoming().role == existing().role ||
                           (existing().role == 'INTRUSO' && incoming().role == 'ALUNO' && isInstitutionalStudentEmail()) ||
                           (existing().role == 'INTRUSO' && incoming().role == 'SERVIDOR' && isServidor())
                         ) &&
                         (incoming().approvalStatus == existing().approvalStatus || (isEmailVerified() && incoming().approvalStatus == 'APROVADO')) &&
                         (!('status' in incoming()) || incoming().status == existing().status) &&
                         (!('suspendedUntil' in incoming()) || incoming().suspendedUntil == existing().suspendedUntil)
                       );

      // 5. Delete: Only Admin can delete accounts (and cannot delete their own active account)
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ==========================================
    // 2. Lost & Found Items Collection
    // ==========================================
    match /items/{itemId} {
      // Public catalog read: anyone on campus (including unauthenticated visitors) can view, search, and scan lost & found objects
      allow get: if true;
      allow list: if true;

      // Creation: ONLY Authenticated users with verified email, real UID and active account standing:
      // - Author ID must match request.auth.uid
      // - Cannot falsify author role as ADMIN or SERVIDOR unless possessing real credentials
      allow create: if isEmailVerified() && 
                    isAccountActive() &&
                    !isIntruso() &&
                    incoming().registeredByUserId == request.auth.uid && 
                    (
                      incoming().registeredByRole == 'ALUNO' ||
                      (incoming().registeredByRole == 'SERVIDOR' && isServidor()) ||
                      (incoming().registeredByRole == 'ADMIN' && isAdmin())
                    );

      // Update: Admin, Servidor, or the authenticated author preserving immutable fields
      allow update: if isAdmin() ||
                       isServidor() ||
                       (
                         isSignedIn() && 
                         isAccountActive() &&
                         existing().registeredByUserId == request.auth.uid && 
                         incoming().registeredByUserId == existing().registeredByUserId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().registeredByRole == existing().registeredByRole
                       );

      // Delete: Admin or the authenticated author who registered the item
      allow delete: if isAdmin() || (isSignedIn() && isAccountActive() && existing().registeredByUserId == request.auth.uid);
    }

    match /found_items/{itemId} {
      allow get: if true;
      allow list: if true;
      allow create: if isEmailVerified() && 
                    isAccountActive() &&
                    !isIntruso() &&
                    incoming().registeredByUserId == request.auth.uid && 
                    (
                      incoming().registeredByRole == 'ALUNO' ||
                      (incoming().registeredByRole == 'SERVIDOR' && isServidor()) ||
                      (incoming().registeredByRole == 'ADMIN' && isAdmin())
                    );
      allow update: if isAdmin() ||
                       isServidor() ||
                       (
                         isSignedIn() && 
                         isAccountActive() &&
                         !isIntruso() &&
                         existing().registeredByUserId == request.auth.uid && 
                         incoming().registeredByUserId == existing().registeredByUserId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().registeredByRole == existing().registeredByRole
                       );
      allow delete: if isAdmin() || (isSignedIn() && isAccountActive() && existing().registeredByUserId == request.auth.uid);
    }

    match /lost_items/{itemId} {
      allow get: if true;
      allow list: if true;
      allow create: if isEmailVerified() && 
                    isAccountActive() &&
                    !isIntruso() &&
                    incoming().registeredByUserId == request.auth.uid && 
                    (
                      incoming().registeredByRole == 'ALUNO' ||
                      (incoming().registeredByRole == 'SERVIDOR' && isServidor()) ||
                      (incoming().registeredByRole == 'ADMIN' && isAdmin())
                    );
      allow update: if isAdmin() ||
                       isServidor() ||
                       (
                         isSignedIn() && 
                         isAccountActive() &&
                         !isIntruso() &&
                         existing().registeredByUserId == request.auth.uid && 
                         incoming().registeredByUserId == existing().registeredByUserId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().registeredByRole == existing().registeredByRole
                       );
      allow delete: if isAdmin() || (isSignedIn() && isAccountActive() && existing().registeredByUserId == request.auth.uid);
    }

    // ==========================================
    // 3. Item Claims Collection (Solicitações de Devolução)
    // ==========================================
    match /claims/{claimId} {
      // Claims can only be read by the claimer, the item author, or Admin/Active Servidor
      allow get: if isSignedIn() && (
        (isAccountActive() && (
          existing().claimerId == request.auth.uid || 
          (exists(/databases/$(database)/documents/items/$(existing().itemId)) && 
           get(/databases/$(database)/documents/items/$(existing().itemId)).data.registeredByUserId == request.auth.uid)
        )) ||
        (isServidor() && isAccountActive()) || 
        isAdmin()
      );
      allow list: if isSignedIn() && ((isServidor() && isAccountActive()) || isAdmin() || (isAccountActive() && resource.data.claimerId == request.auth.uid));

      // Create: Authenticated user making a claim with their own real user id, verified email and active account
      allow create: if isEmailVerified() && isAccountActive() && !isIntruso() && incoming().claimerId == request.auth.uid;

      // Update: Admin / Active Servidor can change claim status/notes;
      // Claimer can update ONLY while status is 'PENDENTE', and CANNOT modify claimerId, itemId, or self-approve
      allow update: if isAdmin() || 
                       (isServidor() && isAccountActive()) ||
                       (
                         isSignedIn() && 
                         isAccountActive() &&
                         existing().claimerId == request.auth.uid && 
                         existing().status == 'PENDENTE' &&
                         incoming().claimerId == existing().claimerId &&
                         incoming().itemId == existing().itemId &&
                         (incoming().status == 'PENDENTE' || incoming().status == 'CANCELADO')
                       );

      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. Notifications Collection (Notificações do Usuário)
    // ==========================================
    match /notifications/{notificationId} {
      // 1. Read (Get): A user can ONLY read notifications addressed to them, or authorized broadcasts; Admins can read all for monitoring
      allow get: if isSignedIn() && (
        existing().userId == request.auth.uid || 
        isAdmin() || 
        existing().userId == 'all' || 
        existing().userId == 'todos_alunos' || 
        existing().userId == 'todos' ||
        existing().isGlobal == true
      );

      // 2. Read (List): A user query only returns documents matching their UID or authorized broadcasts; Admins can query all
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        resource.data.userId == 'all' || 
        resource.data.userId == 'todos_alunos' || 
        resource.data.userId == 'todos' || 
        resource.data.isGlobal == true
      );

      // 3. Create:
      // - Admins and Active Servidores (Campus Staff) can create notifications for any user or institutional broadcasts.
      // - Regular active users (Students/Others) can ONLY create notifications addressed strictly to themselves (request.auth.uid).
      // - Suspended or banned users CANNOT create notifications.
      // - Regular users CANNOT send notifications to other users (anti-spoofing).
      // - Regular users CANNOT create broadcast notifications (isGlobal == true, 'all', etc.).
      // - Regular users CANNOT forge SYSTEM type notifications.
      allow create: if isSignedIn() && (
        isAdmin() || 
        (isServidor() && isAccountActive()) || 
        (
          isAccountActive() &&
          incoming().userId == request.auth.uid &&
          (!('isGlobal' in incoming()) || incoming().isGlobal != true) &&
          incoming().userId != 'all' &&
          incoming().userId != 'todos' &&
          incoming().userId != 'todos_alunos' &&
          incoming().userId != 'todos_servidores' &&
          incoming().userId != 'global' &&
          (!('type' in incoming()) || incoming().type != 'SYSTEM') &&
          incoming().read == false
        )
      );

      // 4. Update:
      // - User can ONLY mark their OWN notification as read.
      // - Strict immutability of core fields: userId (recipientId), title, message, type, isGlobal, timestamp, relatedItemId, id.
      // - User CANNOT change recipientId from A to B.
      // - User CANNOT change isGlobal to true.
      // - User CANNOT mark another user's notification as read.
      // - Admin can perform administrative updates if needed.
      allow update: if (
        isSignedIn() && 
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().title == existing().title &&
        incoming().message == existing().message &&
        (!('type' in existing()) || incoming().type == existing().type) &&
        (!('isGlobal' in existing()) || incoming().isGlobal == existing().isGlobal) &&
        (!('timestamp' in existing()) || incoming().timestamp == existing().timestamp) &&
        (!('relatedItemId' in existing()) || incoming().relatedItemId == existing().relatedItemId) &&
        (!('id' in existing()) || incoming().id == existing().id)
      ) || isAdmin();

      // 5. Delete:
      // - User can ONLY delete their OWN notification (existing().userId == request.auth.uid).
      // - User CANNOT delete another user's notification.
      // - Admin can delete.
      allow delete: if isSignedIn() && (
        existing().userId == request.auth.uid || 
        isAdmin()
      );
    }

    // ==========================================
    // 5. System Configuration Doc (Modo de Manutenção)
    // ==========================================
    match /system/{docId} {
      // Anyone can read maintenance banner state
      allow get: if true;
      allow list: if true;

      // Only verified Admin can modify system settings
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. Audit Logs Collection (Trilha de Auditoria Imutável)
    // ==========================================
    match /activity_logs/{logId} {
      // Only Admin and Active Servidor can inspect audit trail
      allow get: if isAdmin() || (isServidor() && isAccountActive());
      allow list: if isAdmin() || (isServidor() && isAccountActive());

      // Create: Authenticated users can log their real actions without falsifying actor identity
      allow create: if isSignedIn() && (isAccountActive() || isAdmin()) && (
        (
          (isAdmin() || (isServidor() && isAccountActive())) &&
          (
            incoming().adminId == request.auth.uid ||
            incoming().actorId == request.auth.uid
          )
        ) ||
        (
          (incoming().actorId == request.auth.uid || incoming().adminId == request.auth.uid) &&
          (incoming().actorRole == 'ALUNO' || incoming().userRole == 'ALUNO') &&
          incoming().action in ['CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM']
        )
      );

      // Immutability: Audit logs can never be altered or tampered with
      allow update: if false;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      // Admins and Active Servidores can inspect comprehensive audit trail
      allow get: if isAdmin() || (isServidor() && isAccountActive());
      allow list: if isAdmin() || (isServidor() && isAccountActive());

      // Create: Strict non-forgeable audit trail
      // 1. User must be authenticated
      // 2. Client actorId MUST match real authenticated request.auth.uid (no cross-user spoofing)
      // 3. actorEmail MUST match authenticated token email if present
      // 4. actorRole must match user's real role (Admin can log as ADMIN/SERVIDOR; Servidor as SERVIDOR; Aluno as ALUNO)
      // 5. Aluno can only log permitted item actions ('CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM')
      allow create: if isSignedIn() && (isAccountActive() || isAdmin()) &&
        incoming().actorId == request.auth.uid &&
        (request.auth.token.email == null || incoming().actorEmail == request.auth.token.email) &&
        (
          (isAdmin() && incoming().actorRole in ['ADMIN', 'SERVIDOR']) ||
          (isServidor() && isAccountActive() && incoming().actorRole == 'SERVIDOR') ||
          (
            incoming().actorRole == 'ALUNO' &&
            incoming().objectType == 'ITEM' &&
            incoming().action in ['CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM']
          )
        );

      // Strict Immutability: Audit logs can NEVER be updated or deleted by ANY user
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // 7. Backup Logs Collection
    // ==========================================
    match /backup_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && incoming().adminId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ==========================================
    // 8. Error Logs Collection
    // ==========================================
    match /error_logs/{logId} {
      allow get: if isAdmin() || isServidor();
      allow list: if isAdmin() || isServidor();
      allow create: if isSignedIn() && (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ==========================================
    // 9. System Metrics Collection
    // ==========================================
    match /system_metrics/{metricId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      // Only heartbeat document can be written by client app instances to verify liveness/latency
      allow create, update: if isSignedIn() && metricId == 'heartbeat';
      allow delete: if isAdmin();
    }

    // ==========================================
    // 10. Comments Collection
    // ==========================================
    match /comments/{commentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isAccountActive() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isAccountActive() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isAdmin() || (isSignedIn() && isAccountActive() && existing().userId == request.auth.uid);
    }

    // ==========================================
    // 11. FCM Subscriptions Collection
    // ==========================================
    match /fcm_subscriptions/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ==========================================
    // 12. Support & Feedback Tickets Collection
    // ==========================================
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      // Support tickets: allow creation by visitors (no userId allowed) or authenticated users (must match auth.uid and auth email)
      allow create: if (isSignedIn() && incoming().userId == request.auth.uid && (!('email' in incoming()) || incoming().email == request.auth.token.email)) ||
                       (!isSignedIn() && (!('userId' in incoming()) || incoming().userId == null || incoming().userId == ''));
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 13. Document Templates Collection (Admin Only)
    // ==========================================
    match /document_templates/{templateId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 14. Generated Documents Collection (Admin Only)
    // ==========================================
    match /generated_documents/{docId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 15. Project Settings Collection (Admin Only Read & Write)
    // ==========================================
    match /project_settings/{settingsId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 16. Test Battery Executions & Governance (Admin, Servidor & Assigned Testers)
    // ==========================================
    match /test_executions/{executionId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() || isServidor();
      allow update: if isAdmin() || isServidor() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/test_participants/$(request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 17. Test Battery Participants Registry
    // ==========================================
    match /test_participants/{participantId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() || isServidor();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 18. Centralized Test Error Logs Collection
    // ==========================================
    match /test_error_logs/{logId} {
      allow get, list: if isSignedIn();
      allow create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
