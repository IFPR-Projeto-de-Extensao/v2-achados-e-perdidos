{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in IFPR Campus Ivaiporã system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["ALUNO", "SERVIDOR", "ADMIN"] },
        "courseOrDept": { "type": "string", "maxLength": 150 },
        "registrationNumber": { "type": "string", "maxLength": 50 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "LostFoundItem": {
      "title": "LostFoundItem",
      "description": "Lost or found item recorded on Campus Ivaiporã",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["PERDIDO", "ENCONTRADO"] },
        "status": { "type": "string", "enum": ["PERDIDO", "ENCONTRADO", "EM_ANALISE", "DEVOLVIDO"] },
        "description": { "type": "string", "maxLength": 2000 },
        "color": { "type": "string", "maxLength": 50 },
        "brand": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "additionalImages": { "type": "array" },
        "contactInfo": { "type": "string", "maxLength": 200 },
        "registeredByUserId": { "type": "string" },
        "registeredByName": { "type": "string", "maxLength": 100 },
        "registeredByRole": { "type": "string", "enum": ["ALUNO", "SERVIDOR", "ADMIN"] },
        "qrCodeId": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "matchedWithItemId": { "type": "string" },
        "resolutionDate": { "type": "string" },
        "secretVerificationHint": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "category", "type", "status", "description", "location", "registeredByUserId"]
    },
    "ItemClaim": {
      "title": "ItemClaim",
      "description": "Claim made by a user for a found item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemTitle": { "type": "string", "maxLength": 150 },
        "claimerId": { "type": "string" },
        "claimerName": { "type": "string", "maxLength": 100 },
        "claimerEmail": { "type": "string", "maxLength": 150 },
        "claimerRole": { "type": "string", "enum": ["ALUNO", "SERVIDOR", "ADMIN"] },
        "verificationAnswer": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["PENDENTE", "APROVADO", "REJEITADO", "CONCLUIDO"] },
        "createdAt": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "itemId", "claimerId", "verificationAnswer", "status"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "System or match notification for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string", "enum": ["MATCH", "CLAIM_UPDATE", "SYSTEM", "STATUS_CHANGE"] },
        "relatedItemId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read", "type"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global system configuration such as maintenance mode and institutional settings",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceCustomMessage": { "type": "string" },
        "lastBackupTimestamp": { "type": "string" },
        "nextBackupTimestamp": { "type": "string" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of admin operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "adminId", "adminName", "details", "timestamp"]
    },
    "DocumentTemplate": {
      "title": "DocumentTemplate",
      "description": "Editable PDF document template for administrative, extension and institutional documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
        "version": { "type": "number" },
        "headerText": { "type": "string", "maxLength": 1000 },
        "footerText": { "type": "string", "maxLength": 500 },
        "includeLogo": { "type": "boolean" },
        "includeDocNumber": { "type": "boolean" },
        "includeHeader": { "type": "boolean" },
        "includeFooter": { "type": "boolean" },
        "sections": { "type": "array" },
        "fields": { "type": "array" },
        "signatures": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "status", "sections", "fields", "signatures"]
    },
    "GeneratedDocumentRecord": {
      "title": "GeneratedDocumentRecord",
      "description": "History log of documents filled and emitted by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "templateTitle": { "type": "string", "maxLength": 200 },
        "documentNumber": { "type": "string", "maxLength": 100 },
        "recipientOrOrg": { "type": "string", "maxLength": 200 },
        "fieldsData": { "type": "object" },
        "generatedByUserId": { "type": "string" },
        "generatedByName": { "type": "string", "maxLength": 100 },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "templateId", "documentNumber", "generatedByUserId", "generatedAt"]
    },
    "ProjectSettings": {
      "title": "ProjectSettings",
      "description": "Permanent InovaIF team, student members, professor, and campus institutional data for official documents",
      "type": "object",
      "properties": {
        "teamName": { "type": "string", "maxLength": 100 },
        "members": { "type": "array" },
        "professor": { "type": "object" },
        "institution": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["teamName", "members", "professor", "institution"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/LostFoundItem" },
      "description": "Lost and found items collection"
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/ItemClaim" },
      "description": "Claims made on items"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User notifications"
    },
    "/system/{docId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "System configuration doc"
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Activity audit logs"
    },
    "/backup_logs/{logId}": {
      "description": "Backup logs"
    },
    "/error_logs/{logId}": {
      "description": "System error logs"
    },
    "/system_metrics/{metricId}": {
      "description": "System performance metrics"
    },
    "/comments/{commentId}": {
      "description": "Item public and staff comments"
    },
    "/fcm_subscriptions/{userId}": {
      "description": "User Firebase Cloud Messaging tokens and push notification preferences"
    },
    "/support_tickets/{ticketId}": {
      "description": "User feedback and bug report tickets sent to campus support team"
    },
    "/document_templates/{templateId}": {
      "schema": { "$ref": "#/entities/DocumentTemplate" },
      "description": "Document templates for customizable PDF creation (Admin only)"
    },
    "/generated_documents/{docId}": {
      "schema": { "$ref": "#/entities/GeneratedDocumentRecord" },
      "description": "Emission history of generated PDF documents"
    },
    "/found_items/{itemId}": {
      "schema": { "$ref": "#/entities/LostFoundItem" },
      "description": "Found items collection triggering onNewFoundItemCreated Discord alerts"
    },
    "/lost_items/{itemId}": {
      "schema": { "$ref": "#/entities/LostFoundItem" },
      "description": "Lost items collection triggering onNewLostItemCreated Discord alerts"
    },
    "/project_settings/{settingsId}": {
      "schema": { "$ref": "#/entities/ProjectSettings" },
      "description": "Permanent project metadata, InovaIF team members, professor, and campus info"
    }
  }
}
